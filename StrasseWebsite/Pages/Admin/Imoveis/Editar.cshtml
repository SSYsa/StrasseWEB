@page
@model StrasseWebsite.Pages.Admin.Imoveis.EditarModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Editar Imóvel";
}

<div class="container my-5" style="max-width: 800px;">
    <div class="card shadow border-0 p-4">
        <h2 class="fw-bold mb-4 text-secondary">
            Editar Imóvel:
            <span class="text-danger">@Model.Imovel.CodigoImovel</span>
        </h2>

        <form method="post" enctype="multipart/form-data" id="formEditarImovel">
            <input type="hidden" asp-for="Imovel.Id" id="imovelId" />
            <input type="hidden" asp-for="Imovel.CodigoImovel" />
            <input type="hidden" asp-for="ImagemPrincipalSelecionada" id="imagemPrincipalSelecionada" />
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <!-- TÍTULO -->
                <div class="col-md-12">
                    <label class="form-label fw-bold">Título do Anúncio</label>
                    <input asp-for="Imovel.Titulo" class="form-control" />
                    <span asp-validation-for="Imovel.Titulo" class="text-danger"></span>
                </div>

                <!-- DESCRIÇÃO -->
                <div class="col-md-12">
                    <label class="form-label fw-bold">Descrição</label>
                    <textarea asp-for="Imovel.Descricao" class="form-control" rows="4"></textarea>
                </div>

                <!-- PREÇO -->
                <div class="col-md-4">
                    <label class="form-label fw-bold" id="labelPreco">Preço (R$)</label>

                    <input type="text"
                           id="precoVisual"
                           class="form-control"
                           inputmode="decimal"
                           autocomplete="off"
                           placeholder="R$ 0,00"
                           data-valor-inicial="@Model.Imovel.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           data-separador-decimal="@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator" />

                    <input asp-for="Imovel.Preco" type="hidden" id="precoNumerico" />

                    <small id="ajudaPreco" class="text-muted"></small>
                    <span asp-validation-for="Imovel.Preco" class="text-danger"></span>
                </div>

                <!-- CIDADE -->
                <div class="col-md-4">
                    <label class="form-label fw-bold">Cidade / Estado</label>
                    <input asp-for="Imovel.CidadeEstado" class="form-control" />
                </div>

                <!-- BAIRRO -->
                <div class="col-md-4">
                    <label class="form-label fw-bold">Bairro</label>
                    <input asp-for="Imovel.Bairro" class="form-control" />
                </div>

                <!-- ENDEREÇO -->
                <div class="col-md-12">
                    <label class="form-label fw-bold">Endereço Completo</label>
                    <input asp-for="Imovel.Endereco" class="form-control" />
                </div>

                <!-- ESTRUTURA -->
                <div class="col-md-4">
                    <label class="form-label fw-bold">Quartos</label>
                    <input asp-for="Imovel.QuantidadeQuartos" type="number" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Banheiros</label>
                    <input asp-for="Imovel.QuantidadeBanheiros" type="number" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Vagas de Garagem</label>
                    <input asp-for="Imovel.QuantidadeVagasGaragem" type="number" class="form-control" />
                </div>

                <!-- PROPRIETÁRIO -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">Proprietário</label>
                    <select asp-for="Imovel.ProprietarioId"
                            asp-items="Model.ProprietariosList"
                            class="form-select"
                            id="proprietarioSelect"></select>

                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="novoProprietarioCheck" />
                        <label class="form-check-label" for="novoProprietarioCheck">
                            Proprietário não está na lista
                        </label>
                    </div>

                    <div id="novoProprietarioContainer" class="mt-2" style="display:none;">
                        <input asp-for="NovoProprietario"
                               class="form-control"
                               id="novoProprietarioInput"
                               placeholder="Digite o nome do novo proprietário"
                               disabled />
                    </div>
                </div>

                <!-- CORRETOR -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">Corretor Responsável</label>
                    <select asp-for="Imovel.CorretorId"
                            asp-items="Model.CorretoresList"
                            class="form-select"></select>
                </div>

                <!-- TIPO -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">Tipo de Imóvel</label>
                    <select asp-for="Imovel.Tipo"
                            asp-items="Html.GetEnumSelectList<StrasseWebsite.Models.TipoImovel>()"
                            class="form-select"></select>
                </div>

                <!-- TRANSAÇÃO -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">Transação</label>
                    <select asp-for="Imovel.Transacao" class="form-select" id="transacaoSelect">
                        <option value="@TipoTransacao.Compra">Comprar imóvel usado</option>
                        <option value="@TipoTransacao.Construcao">Comprar imóvel novo</option>
                        <option value="@TipoTransacao.Aluguel">Alugar</option>
                    </select>
                </div>

                <!-- IMAGENS -->
                <div class="col-md-12 bg-light p-3 border rounded">
                    <label class="form-label fw-bold text-secondary">Imagem Principal Atual</label>

                    <div class="mb-3" style="max-width: 350px;">
                        @if (!string.IsNullOrWhiteSpace(Model.Imovel.UrlImagemPrincipal))
                        {
                            <div class="position-relative">
                                <img src="@Model.Imovel.UrlImagemPrincipal"
                                     class="img-thumbnail d-block w-100"
                                     style="height: 200px; object-fit: cover; cursor: pointer;"
                                     alt="Imagem principal"
                                     onclick="abrirZoom('@Model.Imovel.UrlImagemPrincipal')" />

                                <button type="button"
                                        class="btn btn-danger btn-sm position-absolute bottom-0 start-0 m-2"
                                        onclick="selecionarPrincipalExistente('@Model.Imovel.UrlImagemPrincipal', this)">
                                    ★ Principal
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small">Nenhuma imagem principal cadastrada.</div>
                        }
                    </div>

                    <hr class="text-muted" />

                    <label class="form-label fw-bold text-secondary mb-3">Galeria de Fotos Atual</label>

                    @if (Model.Imovel.ImagensSecundarias != null && Model.Imovel.ImagensSecundarias.Any())
                    {
                        <div class="row g-2 mb-3">
                            @foreach (var foto in Model.Imovel.ImagensSecundarias)
                            {
                                <div class="col-6 col-md-3 position-relative card-foto"
                                     id="container-foto-@foto.Id">
                                    <img src="@foto.UrlImagem"
                                         class="img-thumbnail d-block w-100"
                                         style="height: 110px; object-fit: cover; cursor: pointer;"
                                         alt="Foto do imóvel"
                                         onclick="abrirZoom('@foto.UrlImagem')" />

                                    <button type="button"
                                            class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2 shadow-sm rounded-circle d-flex align-items-center justify-content-center"
                                            style="width: 26px; height: 26px; padding: 0; font-size: 12px; font-weight: bold; border: 2px solid white;"
                                            title="Excluir Imagem"
                                            onclick="deletarImagemBanco(@foto.Id)">
                                        ✕
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger w-100 mt-1"
                                            onclick="selecionarPrincipalExistente('@foto.UrlImagem', this)">
                                        ☆ Definir como principal
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-3">Nenhuma imagem secundária cadastrada para este imóvel.</p>
                    }

                    <hr class="text-muted" />

                    <!-- NOVAS IMAGENS -->
                    <label class="form-label fw-bold text-danger">Adicionar Novas Fotos</label>

                    <input asp-for="NovasImagens"
                           type="file"
                           class="form-control"
                           accept="image/jpeg,image/png,image/webp"
                           id="novasImagensInput"
                           multiple />

                    <span asp-validation-for="NovasImagens" class="text-danger"></span>

                    <small class="text-muted d-block mt-1">
                        Você pode selecionar quantas imagens quiser.
                        Clique em "Definir como principal" para escolher
                        qual delas será a imagem principal.
                        JPG, PNG ou WEBP. Máximo: 10 MB por imagem.
                    </small>

                    <!-- PREVIEW DAS NOVAS IMAGENS -->
                    <div id="novasImagensPreviewContainer" class="mt-3" style="display:none;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>Novas imagens selecionadas</strong>
                            <span id="quantidadeNovasImagens" class="badge bg-secondary">0 imagens</span>
                        </div>

                        <div id="novasImagensPreview" class="row g-3"></div>
                    </div>
                </div>

                <!-- STATUS -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">Status do Imóvel</label>
                    <select asp-for="Imovel.Status" class="form-select">
                        <option value="Disponivel">Disponível</option>
                        <option value="Vendido">Vendido / Alugado</option>
                        <option value="Inativo">Inativo</option>
                    </select>
                </div>

                <!-- CONSTRUTORA -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">Construtora Responsável</label>
                    <input asp-for="Imovel.ConstrutoraResponsavel"
                           class="form-control"
                           placeholder="Opcional" />
                </div>
            </div>

            <!-- BOTÕES -->
            <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="/Admin/Dashboard" class="btn btn-outline-secondary px-4">Voltar</a>

                <button type="submit"
                        class="btn btn-danger px-5"
                        style="background-color: #C00000; border:none;">
                    Salvar Alterações
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL DE ZOOM -->
<div class="modal fade" id="modalZoomFoto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-body p-0 position-relative text-center">
                <button type="button"
                        class="btn-close btn-close-white position-absolute top-0 end-0 m-3 shadow"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                        style="z-index: 1060; background-color: rgba(0,0,0,0.5); padding: 10px; border-radius: 50%;">
                </button>

                <img src=""
                     id="imgModalZoom"
                     class="img-fluid rounded shadow-lg"
                     style="max-height: 85vh; object-fit: contain;"
                     alt="Imagem Ampliada" />
            </div>
        </div>
    </div>
</div>

<style>
    .card-foto img:hover {
        opacity: 0.85;
        transition: 0.2s ease-in-out;
    }

    .imagem-principal-selecionada {
        border: 3px solid #C00000 !important;
    }
</style>

<script>
    // ZOOM
    function abrirZoom(url) {
        document.getElementById('imgModalZoom').src = url;

        var meuModal = new bootstrap.Modal(
            document.getElementById('modalZoomFoto')
        );

        meuModal.show();
    }

    // SELECIONAR PRINCIPAL EXISTENTE
    function selecionarPrincipalExistente(url, botao) {
        document.getElementById('imagemPrincipalSelecionada').value = url;

        document.querySelectorAll('.imagem-principal-selecionada')
            .forEach(function (elemento) {
                elemento.classList.remove('imagem-principal-selecionada');
            });

        const card = botao.closest('.position-relative, .card-foto');

        if (card) {
            const imagem = card.querySelector('img');

            if (imagem) {
                imagem.classList.add('imagem-principal-selecionada');
            }
        }

        document.querySelectorAll('[data-principal-indicador]')
            .forEach(function (elemento) {
                elemento.remove();
            });

        const indicador = document.createElement('div');
        indicador.setAttribute('data-principal-indicador', 'true');
        indicador.className = 'position-absolute top-0 start-0 m-2 badge bg-danger';
        indicador.textContent = '★ Principal';

        if (card) {
            card.appendChild(indicador);
        }
    }

    // EXCLUIR FOTO
    async function deletarImagemBanco(imagemId) {
        if (!confirm("Tem certeza que deseja remover permanentemente esta imagem da galeria?")) {
            return;
        }

        const token = document.querySelector(
            'input[name="__RequestVerificationToken"]'
        ).value;

        try {
            const resposta = await fetch(
                `/Admin/Imoveis/Editar?handler=DeletarImagem&imagemId=${imagemId}`,
                {
                    method: "POST",
                    headers: {
                        "RequestVerificationToken": token
                    }
                }
            );

            if (resposta.ok) {
                const resultado = await resposta.json();

                if (resultado.sucesso) {
                    const elemento = document.getElementById(`container-foto-${imagemId}`);

                    elemento.style.transition = "all 0.3s ease";
                    elemento.style.opacity = "0";

                    setTimeout(() => {
                        elemento.remove();
                    }, 300);
                } else {
                    alert("Erro ao excluir: " + resultado.mensagem);
                }
            } else {
                alert("Erro de comunicação com o servidor.");
            }
        } catch (erro) {
            console.error(erro);
            alert("Ocorreu uma falha ao tentar remover a imagem.");
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        const checkbox = document.getElementById("novoProprietarioCheck");
        const select = document.getElementById("proprietarioSelect");
        const container = document.getElementById("novoProprietarioContainer");
        const input = document.getElementById("novoProprietarioInput");
        const transacao = document.getElementById("transacaoSelect");
        const labelPreco = document.getElementById("labelPreco");
        const ajudaPreco = document.getElementById("ajudaPreco");

        // PROPRIETÁRIO
        checkbox.addEventListener("change", function () {
            if (this.checked) {
                select.value = "";
                select.disabled = true;
                container.style.display = "block";
                input.disabled = false;
                input.focus();
            } else {
                select.disabled = false;
                container.style.display = "none";
                input.value = "";
                input.disabled = true;
            }
        });

        input.disabled = true;

        // MÁSCARA MONETÁRIA
        const precoVisual = document.getElementById("precoVisual");
        const precoNumerico = document.getElementById("precoNumerico");
        const formulario = document.getElementById("formEditarImovel");
        const separadorDecimal = precoVisual.dataset.separadorDecimal || ",";

        function lerPreco(texto) {
            let valor = texto.replace(/R\$/g, "").replace(/\s/g, "").trim();

            if (!valor) {
                return null;
            }

            if (valor.includes(",")) {
                valor = valor.replace(/\./g, "").replace(",", ".");
            }

            const numero = Number(valor);
            return Number.isFinite(numero) ? numero : null;
        }

        function formatarPreco(numero, incluirCentavos) {
            return numero.toLocaleString("pt-BR", {
                minimumFractionDigits: incluirCentavos ? 2 : 0,
                maximumFractionDigits: 2
            });
        }

        function atualizarValorNumerico() {
            const numero = lerPreco(precoVisual.value);

            if (numero === null) {
                precoNumerico.value = "";
                return;
            }

            // Usa o separador decimal da cultura atual do servidor.
            precoNumerico.value = numero.toFixed(2).replace(".", separadorDecimal);
        }

        function aplicarMascaraPreco() {
            let texto = precoVisual.value
                .replace(/R\$/g, "")
                .replace(/\s/g, "")
                .replace(/[^\d,.]/g, "");

            if (!texto) {
                precoVisual.value = "";
                precoNumerico.value = "";
                return;
            }

            const temVirgula = texto.includes(",");
            const partes = texto.split(",");
            let inteiros = partes[0].replace(/[^\d]/g, "");
            const decimais = temVirgula
                ? partes.slice(1).join("").replace(/[^\d]/g, "").slice(0, 2)
                : "";

            inteiros = inteiros.replace(/^0+(?=\d)/, "");
            inteiros = inteiros.replace(/\B(?=(\d{3})+(?!\d))/g, ".");

            precoVisual.value = "R$ " + (inteiros || "0");

            if (temVirgula) {
                precoVisual.value += "," + decimais;
            }

            atualizarValorNumerico();
        }

        const valorInicial = Number(precoVisual.dataset.valorInicial);

        if (Number.isFinite(valorInicial)) {
            precoVisual.value = "R$ " + formatarPreco(valorInicial, true);
            atualizarValorNumerico();
        }

        precoVisual.addEventListener("input", aplicarMascaraPreco);

        precoVisual.addEventListener("blur", function () {
            const numero = lerPreco(precoVisual.value);

            if (numero !== null) {
                precoVisual.value = "R$ " + formatarPreco(numero, true);
                atualizarValorNumerico();
            }
        });

        formulario.addEventListener("submit", function (evento) {
            atualizarValorNumerico();

            const numero = lerPreco(precoVisual.value);

            if (numero === null || numero < 0) {
                evento.preventDefault();
                alert("Informe um preço válido para o imóvel.");
                precoVisual.focus();
            }
        });

        // PREÇO / ALUGUEL
        function atualizarLabelPreco() {
            if (transacao.value === "Aluguel") {
                labelPreco.textContent = "Valor do Aluguel (R$)";
                ajudaPreco.textContent = "Informe o valor mensal do aluguel.";
            } else {
                labelPreco.textContent = "Preço (R$)";
                ajudaPreco.textContent = "";
            }
        }

        transacao.addEventListener("change", atualizarLabelPreco);
        atualizarLabelPreco();

        // NOVAS IMAGENS
        const imagensInput = document.getElementById("novasImagensInput");
        const previewContainer = document.getElementById("novasImagensPreviewContainer");
        const previewGrid = document.getElementById("novasImagensPreview");
        const quantidade = document.getElementById("quantidadeNovasImagens");

        const tamanhoMaximo = 10 * 1024 * 1024;
        const tiposPermitidos = ["image/jpeg", "image/png", "image/webp"];

        let arquivosSelecionados = [];
        let novaImagemPrincipalIndex = null;

        imagensInput.addEventListener("change", function () {
            const novosArquivos = Array.from(this.files);

            novosArquivos.forEach(function (arquivo) {
                if (!tiposPermitidos.includes(arquivo.type.toLowerCase())) {
                    alert(`A imagem "${arquivo.name}" possui formato inválido.`);
                    return;
                }

                if (arquivo.size > tamanhoMaximo) {
                    alert(`A imagem "${arquivo.name}" ultrapassa o limite de 10 MB.`);
                    return;
                }

                arquivosSelecionados.push(arquivo);
            });

            atualizarPreviews();
        });

        function atualizarPreviews() {
            previewGrid.innerHTML = "";

            const dataTransfer = new DataTransfer();

            arquivosSelecionados.forEach(function (arquivo) {
                dataTransfer.items.add(arquivo);
            });

            imagensInput.files = dataTransfer.files;

            arquivosSelecionados.forEach(function (arquivo, index) {
                const col = document.createElement("div");
                col.className = "col-6 col-md-4 col-lg-3";

                const card = document.createElement("div");
                card.className = "card h-100 shadow-sm";

                const imagem = document.createElement("img");
                imagem.className = "card-img-top";
                imagem.style.height = "150px";
                imagem.style.objectFit = "cover";
                imagem.alt = arquivo.name;
                imagem.src = URL.createObjectURL(arquivo);

                const body = document.createElement("div");
                body.className = "card-body p-2";

                const nome = document.createElement("div");
                nome.className = "small text-muted text-truncate";
                nome.title = arquivo.name;
                nome.textContent = arquivo.name;

                const principal = document.createElement("div");
                principal.className = "small text-danger fw-bold mt-1";

                if (novaImagemPrincipalIndex === index) {
                    principal.textContent = "★ Será a imagem principal";
                }

                const definir = document.createElement("button");
                definir.type = "button";
                definir.className = "btn btn-sm " +
                    (novaImagemPrincipalIndex === index ? "btn-danger" : "btn-outline-danger") +
                    " w-100 mt-2";
                definir.textContent = novaImagemPrincipalIndex === index
                    ? "★ Imagem principal"
                    : "☆ Definir como principal";

                definir.addEventListener("click", function () {
                    novaImagemPrincipalIndex = index;

                    document.getElementById("imagemPrincipalSelecionada").value =
                        "__NOVA__" + index;

                    atualizarPreviews();
                });

                const remover = document.createElement("button");
                remover.type = "button";
                remover.className = "btn btn-sm btn-outline-secondary w-100 mt-2";
                remover.textContent = "Remover";

                remover.addEventListener("click", function () {
                    if (novaImagemPrincipalIndex === index) {
                        novaImagemPrincipalIndex = null;
                        document.getElementById("imagemPrincipalSelecionada").value = "";
                    } else if (novaImagemPrincipalIndex !== null && index < novaImagemPrincipalIndex) {
                        novaImagemPrincipalIndex--;
                    }

                    arquivosSelecionados.splice(index, 1);
                    atualizarPreviews();
                });

                body.appendChild(nome);
                body.appendChild(principal);
                body.appendChild(definir);
                body.appendChild(remover);

                card.appendChild(imagem);
                card.appendChild(body);
                col.appendChild(card);
                previewGrid.appendChild(col);
            });

            quantidade.textContent = arquivosSelecionados.length +
                (arquivosSelecionados.length === 1 ? " imagem" : " imagens");

            previewContainer.style.display = arquivosSelecionados.length > 0
                ? "block"
                : "none";
        }
    });
</script>
