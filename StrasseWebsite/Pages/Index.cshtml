@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero-banner">

    <div class="hero-overlay"></div>

    <div class="hero-container">

        <h1 class="hero-brand">
            STRASSE <span>IMÓVEIS</span>
        </h1>

        <div class="hero-slogan-box">
            <h2>Construindo conexões, encontrando lares!</h2>
            <p>
                Seu Parceiro de Confiança para Comprar, Vender ou Alugar Imóveis no Brasil.
            </p>
        </div>


        <!-- FORMULÁRIO PRINCIPAL -->
        <form method="get"
              action="/Listagem"
              class="search-bar-container">

            <!-- OPERAÇÃO -->
            <div class="search-field">

                <label for="operacao">
                    O que deseja fazer?
                </label>

                <select id="operacao" name="operacao">

                    <option value="">
                        Selecione a opção...
                    </option>

                    <option value="alugar">
                        Alugar
                    </option>

                    <option value="comprar">
                        Comprar imóvel usado
                    </option>

                    <option value="construir">
                        Comprar imóvel novo
                    </option>

                </select>

            </div>


            <!-- TIPO DE IMÓVEL -->
            <div class="search-field">

                <label for="tipoImovel">
                    Tipo de Imóvel
                </label>

                <select id="tipoImovel" name="tipo">

                    <option value="">
                        Todos os tipos...
                    </option>

                    <option value="Apartamento">
                        Apartamento
                    </option>

                    <option value="Casa">
                        Casa
                    </option>

                    <option value="Terreno">
                        Terreno
                    </option>

                </select>

            </div>


            <!-- LOCALIZAÇÃO -->
<div class="search-field">

    <label for="localizacaoDropdown">
        Onde procura?
    </label>

    <div class="location-multiselect">

        <button type="button"
                id="localizacaoDropdown"
                class="location-select-button">

            <span id="localizacaoSelecionadas">
                Selecione cidade(s)...
            </span>

            <span class="location-select-arrow">
                ▼
            </span>

        </button>


        <div id="localizacaoOpcoes"
             class="location-options">

            @foreach (var localizacao in Model.LocalizacoesDisponiveis)
            {
                <label class="location-option">

                    <input type="checkbox"
                           name="localizacao"
                           value="@localizacao" />

                    <span>
                        @Model.FormatarCidadeEstado(localizacao)
                    </span>

                </label>
            }

        </div>

    </div>

</div>


            <!-- BUSCAR -->
            <div class="search-action">

                <button type="submit"
                        class="btn-search">
                    Buscar
                </button>

            </div>

        </form>

    </div>

</section>


<!-- ================================ -->
<!-- IMÓVEIS EM DESTAQUE -->
<!-- ================================ -->

<section class="properties-section">

    <div class="properties-container">

        <div class="section-header">

            <h2>
                Imóveis em Destaque
            </h2>

            <div class="title-line"></div>

        </div>


        <div class="properties-grid">

            @if (Model.ImoveisHome != null &&
                 Model.ImoveisHome.Any())
            {

                @foreach (var imovel in Model.ImoveisHome)
                {

                    <a href="/Detalhes?id=@imovel.Id"
                       class="property-card-link">

                        <div class="property-card">

                            <div class="card-image">

                                <img src="@imovel.UrlImagemPrincipal"
                                     alt="@imovel.Titulo"
                                     onerror="this.src='https://placehold.co/400x250?text=Strasse+Im%C3%B3veis'" />

                                <span class="badge-status">

                                    @if (imovel.Transacao == TipoTransacao.Aluguel)
                                    {
                                        <text>Aluguel</text>
                                    }
                                    else if (imovel.Transacao == TipoTransacao.Construcao)
                                    {
                                        <text>Imóvel Novo</text>
                                    }
                                    else
                                    {
                                        <text>Venda</text>
                                    }

                                </span>

                            </div>


                            <div class="card-content">

                                <h3 class="property-price">

                                    @imovel.Preco.ToString(
                                        "C0",
                                        new System.Globalization.CultureInfo("pt-BR"))

                                    @if (imovel.Transacao == TipoTransacao.Aluguel)
                                    {
                                        <small>/mês</small>
                                    }

                                </h3>


                                <h4 class="property-title">
                                    @imovel.Titulo
                                </h4>


                                <p class="property-location">

                                    @imovel.Bairro,
                                    @Model.FormatarCidadeEstado(imovel.CidadeEstado)

                                </p>


                                <div class="property-details">

                                    @if (imovel.QuantidadeQuartos > 0)
                                    {
                                        <span>
                                            @imovel.QuantidadeQuartos Quartos
                                        </span>
                                    }

                                    @if (imovel.QuantidadeVagasGaragem > 0)
                                    {
                                        <span>
                                            @imovel.QuantidadeVagasGaragem Vagas
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                    </a>

                }

            }
            else
            {

                <div class="no-properties">

                    <p>
                        Nenhum imóvel disponível no momento.
                    </p>

                </div>

            }

        </div>

    </div>

</section>


<!-- ================================ -->
<!-- CONSTRUÇÃO PERSONALIZADA -->
<!-- ================================ -->

<section class="about-section">

    <div class="about-container">

        <div class="build-banner">

            <a href="/Listagem?operacao=construir"
               class="btn-build-highlight">

                <span class="icon-hammer">
                    🔨
                </span>

                Quero Construir meu Imóvel Personalizado

            </a>

        </div>


        <div class="about-content-wrapper">


            <div class="about-image-box">

                <img src="/images/about-strasse.jpg"
                     alt="Conheça a Strasse"
                     onerror="this.src='/images/icon/portalpomerode.jpeg'" />

            </div>


            <div class="about-text-box">

                <span class="about-subtitle">
                    Sua escolha inteligente
                </span>


                <h2>
                    Conheça a Strasse Imóveis
                </h2>


                <div class="title-line-left"></div>


                <p class="about-description">

